  // The customer went with, or is comparing with, another provider. Not an objection type of its own: it decides the loss reason.
  "competitor": [ "en otro lado", "en otra parte", "en otra clinica", "en otro centro", "en otro sitio", "en otro lugar", "otra clinica", "otro centro", "otro lugar", "otra empresa", "la competencia", "me ofrecieron", "ya me hice", "ya me depile", "ya me la hice", "ya agende en", "ya reserve en", "ya compre", "ya pague en", "alla me hacen", "alla me cobran", "ya tengo donde" ],

  // The customer asks something about the service: interest even without an objection or a booking.
  "inquiry": [ "cuanto cuesta", "cuanto cuestan", "cuanto vale", "cuanto valen", "cuanto es", "cuanto sale", "cuanto me sale", "cuanto seria", "precio*", "valor", "valores", "costo*", "tarifa*", "informacion", "mas informacion", "como funciona", "cuantas sesiones", "cuantas", "sesion*", "horario*", "ubicacion", "direccion", "donde quedan", "donde estan", "donde queda", "tienen sede", "sede*", "sucursal*", "valoracion", "cotizacion", "cotizar", "cotizame", "quisiera saber", "quiero saber", "me interesa", "me gustaria", "quisiera", "interesad*", "quiero hacerme", "quiero depilarme", "necesito", "tratamiento*", "resultados", "duracion", "cuanto dura", "cuanto demora" ],

  // The customer wants to book (or move a booking). Negated mentions ("no quiero agendar") are not intent.
