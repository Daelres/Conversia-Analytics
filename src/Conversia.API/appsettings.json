{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=conversia;Username=conversia;Password=change_me"
  },
  "Jwt": {
    "SigningKey": "REPLACE_WITH_A_STRONG_SECRET_AT_LEAST_32_BYTES_LONG",
    "Issuer": "Conversia",
    "Audience": "Conversia"
  },
  "ErrorLogging": {
    "Enabled": true,
    "RetentionDays": 90,
    "MaxPerFingerprintPerMinute": 20,
    "PersistTimeoutSeconds": 3,
    "ReportRateLimitPerMinute": 60
  },
  "Dialog360": {
    "ApiKey": ""
  },
  "Webhooks": {
    "MaxBodyBytes": 1048576,
    "RateLimitPerMinute": 600,
    "Processing": {
      "Enabled": true,
      "PollIntervalMilliseconds": 2000,
      "BatchSize": 20,
      "MaxAttempts": 5,
      "RetryBaseDelaySeconds": 30
    }
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  }
}
