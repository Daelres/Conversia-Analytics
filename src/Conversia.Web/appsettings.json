{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Api": {
    "BaseUrl": "https://localhost:7199/",
    "TimeoutSeconds": 10
  },
  "ErrorReporting": {
    "Enabled": true,
    "TimeoutSeconds": 2,
    "MaxPerFingerprintPerMinute": 20
  }
}
