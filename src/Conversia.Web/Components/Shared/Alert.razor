<div class="alert alert--@KindName" role="@Role" @attributes="Attributes">
    <Icon Name="@IconName" Class="alert__icon" />
    <div class="alert__body">
        @if (Title is not null)
        {
            <strong class="alert__title">@Title</strong>
        }
        <div>@ChildContent</div>
        @if (Actions is not null)
        {
            <div class="alert__actions">@Actions</div>
        }
    </div>
</div>

@code {
    [Parameter]
    public AlertKind Kind { get; set; } = AlertKind.Danger;

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? Attributes { get; set; }

    private string KindName => Kind.ToString().ToLowerInvariant();

    // Problems interrupt (alert); confirmations and hints are announced politely (status).
    private string Role => Kind is AlertKind.Danger or AlertKind.Warning ? "alert" : "status";

    private string IconName => Kind switch
    {
        AlertKind.Success => "check-circle",
        AlertKind.Warning => "alert-triangle",
        AlertKind.Info => "info",
        _ => "alert-circle",
    };
}
