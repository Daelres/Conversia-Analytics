    <ChildContent>Esa conversación no existe en tu espacio de trabajo o ya no está disponible.</ChildContent>
    <Actions>
        <a class="btn btn--primary" href="/conversaciones"><Icon Name="arrow-left" />Volver a conversaciones</a>
    </Actions>
</StatusView>
