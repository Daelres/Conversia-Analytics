@* The page of a WhatsApp number that does not exist in the caller's workspace. *@
<StatusView DataPage="not-found" Code="404" Title="Número no encontrado" Art="search">
    <ChildContent>Ese número no existe en tu espacio de trabajo o ya no está disponible.</ChildContent>
    <Actions>
        <a class="btn btn--primary" href="/organizacion"><Icon Name="arrow-left" />Volver a organización</a>
    </Actions>
</StatusView>
