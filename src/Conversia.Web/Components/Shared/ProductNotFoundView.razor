@* The page of a product that does not exist in the caller's workspace (or was deleted). *@
<StatusView DataPage="not-found" Code="404" Title="Producto no encontrado" Art="search">
    <ChildContent>@UiMessages.ProductNotFound Ese producto no existe en tu espacio de trabajo o fue eliminado.</ChildContent>
    <Actions>
        <a class="btn btn--primary" href="/products"><Icon Name="arrow-left" />Volver a productos</a>
    </Actions>
</StatusView>
