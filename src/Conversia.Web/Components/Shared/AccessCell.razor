<td data-testid="access-cell" data-permission="@Permission" data-held="@(Held ? "true" : "false")">
    @if (Held)
    {
        <span class="access access--yes"><Icon Name="check" />Sí<span class="sr-only">: permitido</span></span>
    }
    else
    {
        <span class="access access--no"><Icon Name="x" />No<span class="sr-only">: no permitido</span></span>
    }
</td>

@code {
    [Parameter, EditorRequired]
    public Conversia.Domain.Enums.Permission Permission { get; set; }

    [Parameter]
    public bool Held { get; set; }
}
