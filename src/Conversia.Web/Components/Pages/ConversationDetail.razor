@page "/conversaciones/{Id:guid}"
@attribute [Authorize]
@using Conversia.Application.DTOs.Conversations
@using Conversia.Application.DTOs.Organization
@using Conversia.Application.Time
@using Conversia.Domain.Enums
@using Conversia.Web.Components.Conversations
@using Conversia.Web.Http
@using Conversia.Web.Time
@inherits AuthenticatedPageBase
@inject TenantTimeZone TimeZone
@inject TimeProvider Clock
@inject OneTimeSubmissions Submissions

<PageTitle>Conversación - Conversia</PageTitle>

@if (Denied)
{
    <StatusView DataPage="forbidden" Code="403" Title="Sin acceso a las conversaciones" Art="locked"
                Hint="Pide acceso a la persona propietaria de tu empresa.">
        <ChildContent>Tu cuenta no tiene el permiso «@PermissionLabels.For(Permission.ConversationsView)». Con él podrás ver los chats de ventas y su resultado.</ChildContent>
        <Actions>
            <a class="btn btn--primary" href="/"><Icon Name="home" />Ir al inicio</a>
        </Actions>
    </StatusView>
}
else if (_missing)
{
    <ConversationNotFoundView />
}
else if (!Redirected)
{
    <div class="page" data-page="conversation" data-conversation-id="@Id">
        <PageHeader Eyebrow="Conversaciones" EyebrowIcon="message" Title="@Heading" Description="@Subheading">
            <a class="btn btn--secondary" href="/conversaciones"><Icon Name="arrow-left" />Volver a conversaciones</a>
        </PageHeader>

        @if (ConversationsNotice.Describe(Notice) is { } notice)
        {
            <Alert Kind="AlertKind.Success" data-testid="notice-success">@notice</Alert>
        }

        <ErrorAlert Message="@Message" />

        @if (_modified)
        {
            <Alert Kind="AlertKind.Warning" data-testid="notice-modified">
                <ChildContent>Otra persona modificó esta conversación mientras la editabas. Recárgala para ver la última versión.</ChildContent>
                <Actions>
                    <a class="btn btn--secondary btn--sm" href="@ConversationLinks.Detail(Id)"><Icon Name="refresh" Class="icon--sm" />Recargar</a>
                </Actions>
            </Alert>
        }

        @if (_conversation is not null)
        {
            <ul class="cluster conversation__chips" aria-label="Resumen de la conversación" data-testid="conversation-summary">
                <li><StageChip Stage="@_conversation.Opportunity.Stage" /></li>
                <li><SourceChip Source="@_conversation.Source" /></li>
                @if (_conversation.IsSandbox)
                {
                    <li><Chip Tone="ChipTone.Warning" IconName="zap" data-testid="sandbox-chip">Sandbox</Chip></li>
                }
                <li><Chip IconName="@(_conversation.Status == "Open" ? "message" : "check")" data-testid="status-chip" data-status="@_conversation.Status">@ConversationLabels.Status(_conversation.Status)</Chip></li>
                <li><Chip IconName="building" data-testid="branch-chip">@(_conversation.BranchName ?? MetricsFormat.NoData)</Chip></li>
                <li><Chip IconName="user" data-testid="advisor-chip">@(_conversation.AdvisorName ?? "Sin asignar")</Chip></li>
                <li><ReplyChip Conversation="_conversation" NowUtc="_nowUtc" /></li>
            </ul>
        }

        <div class="conversation-layout">
            <div class="stack">
                @if (_conversation is not null)
                {
                    <Card Title="Chat" Subtitle="@ChatSubtitle" IconName="message" data-testid="chat-card">
                        <ChatThread Messages="_conversation.Messages" ToLocal="TimeZone.ToLocal" />
                        @if (_conversation.MessageCount > _conversation.Messages.Count)
                        {
                            <p class="muted" data-testid="chat-truncated">Se muestran los primeros @MetricsFormat.Whole(_conversation.Messages.Count) de @MetricsFormat.Whole(_conversation.MessageCount) mensajes.</p>
                        }
                    </Card>
                }

                <MessageComposer State="_composer" SubmissionId="@_submissionId" Error="@_sendError" ApiErrors="_sendErrors" OnSend="SendAsync" OnInvalid="LoadAsync" />

                @* The second composer of a sandbox conversation: one person plays both sides. In a scope of its own, so that its form is
                   not the advisor's. Always in the render tree (hidden unless offered): a forged post reaches the API and is refused there. *@
                <FormMappingScope Name="@MessageComposer.CustomerScope">
                    <MessageComposer Customer="true" State="_customerComposer" SubmissionId="@_customerSubmissionId" Error="@_customerError" ApiErrors="_customerErrors"
                                     OnSend="SendAsCustomerAsync" OnInvalid="LoadAsync" />
                </FormMappingScope>
            </div>

            <div class="stack conversation-side">
                @if (_conversation is not null)
                {
                    <OpportunityCard Opportunity="_conversation.Opportunity" ToLocal="TimeZone.ToLocal" />

                    <Card Title="Datos de la conversación" IconName="info" data-testid="conversation-facts">
                        <dl class="kv">
                            <div>
                                <dt>Inicio</dt>
                                <dd>@MetricsFormat.Moment(TimeZone.ToLocal(_conversation.StartedAt))</dd>
                            </div>
                            <div>
                                <dt>Último mensaje</dt>
                                <dd>@MetricsFormat.Moment(TimeZone.ToLocal(_conversation.LastMessageAt)) · @ConversationFormat.Age(_conversation.LastMessageAt, _nowUtc)</dd>
                            </div>
                            @if (_conversation.ClosedAt is { } closed)
                            {
                                <div>
                                    <dt>Cierre</dt>
                                    <dd>@MetricsFormat.Moment(TimeZone.ToLocal(closed))</dd>
                                </div>
                            }
                            <div>
                                <dt>Asesor asignado</dt>
                                <dd data-testid="assigned-advisor">
                                    @(_conversation.AdvisorName ?? "Sin asignar")
                                    @if (_conversation.AdvisorAssignedBy is { } by)
                                    {
                                        <span class="muted" data-testid="advisor-assigned-by" data-user-id="@by">Asignado por el usuario @ConversationFormat.ShortId(by)@(_conversation.AdvisorAssignedAt is { } at ? $" el {MetricsFormat.Moment(TimeZone.ToLocal(at))}" : "").</span>
                                    }
                                </dd>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_conversation.SourceReference))
                            {
                                <div>
                                    <dt>Anuncio de origen</dt>
                                    <dd class="mono" data-testid="source-reference">@_conversation.SourceReference</dd>
                                </div>
                            }
                        </dl>
                    </Card>
                }

                @* Always rendered: a POST can only be dispatched to a form that exists in the render tree, and a caller
                   without ConversationsManage who forges one must still reach the API and be refused there, not crash here. *@
                <div hidden="@(!CanManage)" data-testid="manage-panel">
                    <div class="stack">
                        <Card Title="Asignar asesor" Subtitle="Asesores activos de esta sucursal." IconName="user">
                            <EditForm Model="Assign" FormName="assign-advisor" OnValidSubmit="AssignAsync" OnInvalidSubmit="LoadAsync" method="post" class="form" data-testid="assign-form">
                                <DataAnnotationsValidator />
                                <FormField TValue="string" For="() => Assign.AdvisorId" Id="assign-advisor" Label="Asesor" IconName="user" ApiErrors="_assignErrors" Context="field">
                                    <InputSelect id="assign-advisor" class="input" name="@($"{nameof(Assign)}.{nameof(AssignAdvisorInput.AdvisorId)}")" @bind-Value="Assign.AdvisorId" @attributes="field">
                                        <option value="">Sin asesor</option>
                                        @foreach (var advisor in BranchAdvisors)
                                        {
                                            <option value="@advisor.Id">@advisor.Name@(advisor.IsActive ? "" : " (inactivo)")</option>
                                        }
                                    </InputSelect>
                                </FormField>
                                <ApiFieldErrors Errors="_assignErrors" KnownFields="@(["AdvisorId"])" />
                                <div class="form-actions">
                                    @if (CanManage)
                                    {
                                        <button type="submit" class="btn btn--primary"><Icon Name="check" />Guardar asesor</button>
                                    }
                                </div>
                            </EditForm>
                        </Card>

                        <Card Title="Definir el resultado" Subtitle="Tu decisión manda sobre el clasificador." IconName="tag">
                            <EditForm Model="Outcome" FormName="set-outcome" OnValidSubmit="SaveOutcomeAsync" OnInvalidSubmit="LoadAsync" method="post" class="form" data-testid="outcome-form">
                                <DataAnnotationsValidator />
                                <FormField TValue="string" For="() => Outcome.Stage" Id="outcome-stage" Label="Resultado" IconName="check-circle" Hint="Ganada: compró o agendó. Perdida: no se concretó. Al guardar, el clasificador automático ya no cambia esta etapa." ApiErrors="_outcomeErrors" Context="field">
                                    <InputSelect id="outcome-stage" class="input" name="@($"{nameof(Outcome)}.{nameof(OutcomeInput.Stage)}")" @bind-Value="Outcome.Stage" @attributes="field">
                                        <option value="">Elige un resultado</option>
                                        @* Written as a loop so each option is its own element: the server can then mark the chosen one as selected. *@
                                        @foreach (var (value, label) in StageChoices)
                                        {
                                            <option value="@value">@label</option>
                                        }
                                    </InputSelect>
                                </FormField>
                                <FormField TValue="string" For="() => Outcome.LossReason" Id="outcome-reason" Label="Motivo de pérdida" Hint="Solo si la venta se perdió." ApiErrors="_outcomeErrors" Context="field">
                                    <InputSelect id="outcome-reason" class="input" name="@($"{nameof(Outcome)}.{nameof(OutcomeInput.LossReason)}")" @bind-Value="Outcome.LossReason" @attributes="field">
                                        <option value="">Sin motivo</option>
                                        @foreach (var reason in ConversationLabels.LossReasons)
                                        {
                                            <option value="@reason">@ConversationLabels.LossReason(reason)</option>
                                        }
                                    </InputSelect>
                                </FormField>
                                <FormField TValue="string" For="() => Outcome.Detail" Id="outcome-detail" Label="Detalle" Hint="Opcional, hasta 500 caracteres. No incluyas datos personales." ApiErrors="_outcomeErrors" Context="field">
                                    <InputTextArea id="outcome-detail" class="input" rows="3" maxlength="500" name="@($"{nameof(Outcome)}.{nameof(OutcomeInput.Detail)}")" @bind-Value="Outcome.Detail" @attributes="field" />
                                </FormField>
                                <ApiFieldErrors Errors="_outcomeErrors" KnownFields="@(["Stage", "LossReason", "Detail"])" />
                                <div class="form-actions">
                                    @if (CanManage)
                                    {
                                        <button type="submit" class="btn btn--primary"><Icon Name="check" />Guardar resultado</button>
                                    }
                                </div>
                            </EditForm>
                        </Card>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private ConversationDetailResponse? _conversation;
    private IReadOnlyList<AdvisorResponse>? _advisors;
    private bool _missing;
    private bool _modified;
    private bool _prefilled;
    private DateTime _nowUtc;
    private IReadOnlyDictionary<string, string[]>? _assignErrors;
    private IReadOnlyDictionary<string, string[]>? _outcomeErrors;
    private IReadOnlyDictionary<string, string[]>? _sendErrors;
    private ComposerState _composer = ComposerState.Unknown;
    private string _submissionId = OneTimeSubmissions.NewId();
    private string? _sendError;
    private ComposerState _customerComposer = ComposerState.Unknown;
    private string _customerSubmissionId = OneTimeSubmissions.NewId();
    private string? _customerError;
    private IReadOnlyDictionary<string, string[]>? _customerErrors;

    private AssignAdvisorInput? _assign;
    private OutcomeInput? _outcome;

    [SupplyParameterFromForm(FormName = "assign-advisor")]
    private AssignAdvisorInput Assign
    {
        get => _assign ??= new();
        set => _assign = value;
    }

    [SupplyParameterFromForm(FormName = "set-outcome")]
    private OutcomeInput Outcome
    {
        get => _outcome ??= new();
        set => _outcome = value;
    }

    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromQuery]
    public string? Notice { get; set; }

    private bool CanManage { get; set; }

    private static readonly (string Value, string Label)[] StageChoices =
    [
        ("Won", "Ganada"),
        ("Lost", "Perdida"),
        ("InFollowUp", "En seguimiento"),
    ];

    private string Heading => _conversation is null
        ? "Conversación"
        : string.IsNullOrWhiteSpace(_conversation.Contact.DisplayName) ? $"Cliente {ConversationFormat.MaskedPhone(_conversation.Contact.WaId)}" : _conversation.Contact.DisplayName.Trim();

    private string? Subheading => _conversation is null ? null : $"WhatsApp {_conversation.Contact.WaId}";

    private string ChatSubtitle => _conversation is null
        ? string.Empty
        : $"{MetricsFormat.Whole(_conversation.MessageCount)} {(_conversation.MessageCount == 1 ? "mensaje" : "mensajes")}, a la hora de tu negocio.";

    // Only the advisors of this conversation's branch can take it; the current one is listed even if it was deactivated since.
    private IEnumerable<AdvisorResponse> BranchAdvisors
        => (_advisors ?? []).Where(advisor => _conversation is not null && advisor.BranchId == _conversation.BranchId && (advisor.IsActive || advisor.Id == _conversation.AdvisorId));

    protected override async Task OnInitializedAsync()
    {
        if (!await TryReadTokenAsync())
        {
            return;
        }

        _nowUtc = Clock.GetUtcNow().UtcDateTime;
        if (!IsPost)
        {
            await LoadAsync();
        }
    }

    protected override void OnNotFound()
    {
        _missing = true;
        NotFoundMarker.Mark(HttpContext, NotFoundMarker.Conversation);
        SetStatusCode(StatusCodes.Status404NotFound);
        Message = null;
    }

    private async Task LoadAsync()
    {
        var detailTask = Api.GetConversationAsync(Token!, Id);
        var profileTask = Api.GetMyProfileAsync(Token!);
        var advisorsTask = Api.GetAdvisorsAsync(Token!);
        await Task.WhenAll(detailTask, profileTask, advisorsTask);

        if (await TryFailAsync(detailTask.Result, profileTask.Result))
        {
            return;
        }

        Shell.Remember(profileTask.Result.Value!);
        if (!profileTask.Result.Value!.Can(Permission.ConversationsView))
        {
            Deny();
            return;
        }

        _conversation = detailTask.Result.Value;
        CanManage = profileTask.Result.Value!.Can(Permission.ConversationsManage);

        // The conversation itself says whether its line can send, so a person who may write needs no access to the organization.
        // In sandbox mode (docs/SANDBOX.md) a sandbox conversation needs no provider key, and a real one takes no message; outside it, the reverse.
        var sandboxMode = profileTask.Result.Value!.TenantSandboxMode;
        _composer = ComposerState.For(CanManage, _conversation!.Status, _conversation.Channel, sandboxMode, _conversation.IsSandbox);
        _customerComposer = CustomerComposer.For(CanManage, _conversation.Status, _conversation.Channel, sandboxMode, _conversation.IsSandbox);

        // Choosing an advisor needs to see them: without OrganizationView the list is simply empty (the current advisor is still named).
        _advisors = advisorsTask.Result.IsSuccess ? advisorsTask.Result.Value : null;

        if (!IsPost && !_prefilled)
        {
            _prefilled = true;
            Assign.AdvisorId = _conversation!.AdvisorId?.ToString();
            Outcome.Stage = OutcomeInput.Stages.Contains(_conversation.Opportunity.Stage) ? _conversation.Opportunity.Stage : null;
            Outcome.LossReason = _conversation.Opportunity.Stage == "Lost" ? _conversation.Opportunity.LossReason : null;
            Outcome.Detail = _conversation.Opportunity.Stage == "Lost" ? _conversation.Opportunity.LossDetail : null;
        }
    }

    private async Task SendAsync(SendMessageInput input)
    {
        // The provider is called once per form: a double click or a reload of the answer must not send the message twice.
        // The claim belongs to the signed-in user and this conversation, so nobody else's forms can use it up or push it out.
        var sender = HttpContext.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        if (!Submissions.TryClaim(sender, Id.ToString("N"), input.SubmissionId))
        {
            _sendError = SendFailure.AlreadySubmitted;
            await LoadAsync();
            return;
        }

        var result = await Api.SendMessageAsync(Token!, Id, input.ToRequest());
        if (result.IsSuccess)
        {
            RedirectTo(ConversationsNotice.Url(Id, ConversationsNotice.MessageSent));
            return;
        }

        if (SendFailure.MessageLeft(result.ProblemCode))
        {
            input.Text = null;
        }

        switch (result.Status)
        {
            case ApiResultStatus.ValidationFailed:
                _sendErrors = result.ValidationErrors;
                SetStatusCode(StatusCodes.Status400BadRequest);
                break;
            case ApiResultStatus.RateLimited when result.ProblemCode is null:
                _sendError = SendFailure.TooManyMessages(result.RetryAfterSeconds);
                SetStatusCode(StatusCodes.Status429TooManyRequests);
                break;
            case ApiResultStatus.Conflict or ApiResultStatus.Unprocessable or ApiResultStatus.RateLimited or ApiResultStatus.Unavailable
                when SendFailure.Describe(result.ProblemCode) is { } described:
                _sendError = described;
                SetStatusCode(result.Status switch
                {
                    ApiResultStatus.Conflict => StatusCodes.Status409Conflict,
                    ApiResultStatus.Unprocessable => StatusCodes.Status422UnprocessableEntity,
                    ApiResultStatus.RateLimited => StatusCodes.Status429TooManyRequests,
                    _ when SendFailure.MessageLeft(result.ProblemCode) => StatusCodes.Status500InternalServerError,
                    _ => StatusCodes.Status503ServiceUnavailable,
                });
                break;
            case ApiResultStatus.Conflict:
                _sendError = result.Detail ?? UiMessages.Unavailable;
                SetStatusCode(StatusCodes.Status409Conflict);
                break;
            case ApiResultStatus.Unavailable:
                // No answer the Web can use: a timeout, a dropped connection, a gateway or an API that failed. The request may have reached
                // the provider all the same, so the person is told what an unavailable provider would tell them. It was already logged and
                // reported as an upstream failure, and its error code is on the page.
                _sendError = SendFailure.OutcomeUnknown;
                SetStatusCode(StatusCodes.Status503ServiceUnavailable);
                break;
            default:
                await TryFailAsync(result);
                break;
        }

        if (!Redirected && !_missing && !Denied)
        {
            await LoadAsync();
        }
    }

    // The simulated customer writes: the API puts the message in the ingestion queue, so it shows up a moment later, not in this answer.
    private async Task SendAsCustomerAsync(SendMessageInput input)
    {
        var sender = HttpContext.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        if (!Submissions.TryClaim(sender, $"{Id:N}-customer", input.SubmissionId))
        {
            _customerError = SandboxFailure.AlreadySubmitted;
            await LoadAsync();
            return;
        }

        var result = await Api.SendSandboxCustomerMessageAsync(Token!, Id, new() { Text = input.Text?.Trim() });
        if (result.IsSuccess)
        {
            RedirectTo(ConversationsNotice.Url(Id, ConversationsNotice.CustomerMessageQueued));
            return;
        }

        switch (result.Status)
        {
            case ApiResultStatus.ValidationFailed:
                _customerErrors = result.ValidationErrors;
                SetStatusCode(StatusCodes.Status400BadRequest);
                break;
            case ApiResultStatus.RateLimited:
                _customerError = SandboxFailure.TooManyMessages(result.RetryAfterSeconds);
                SetStatusCode(StatusCodes.Status429TooManyRequests);
                break;
            case ApiResultStatus.Conflict:
                _customerError = SandboxFailure.Describe(result.ProblemCode) ?? result.Detail ?? UiMessages.Unavailable;
                SetStatusCode(StatusCodes.Status409Conflict);
                break;
            default:
                await TryFailAsync(result);
                break;
        }

        if (!Redirected && !_missing && !Denied)
        {
            await LoadAsync();

            // A refusal must stay readable even when the composer is no longer offered (the mode went off, the conversation closed).
            if (_customerError is not null && _customerComposer.Availability == ComposerAvailability.Unknown)
            {
                Message = _customerError;
            }
        }
    }

    private async Task AssignAsync()
    {
        if (!Assign.IsValid)
        {
            _assignErrors = new Dictionary<string, string[]> { ["AdvisorId"] = ["Elige un asesor de la lista."] };
            await LoadAsync();
            return;
        }

        var result = await Api.AssignAdvisorAsync(Token!, Id, Assign.ToRequest());
        if (result.IsSuccess)
        {
            RedirectTo(ConversationsNotice.Url(Id, ConversationsNotice.AdvisorChanged));
            return;
        }

        switch (result.Status)
        {
            case ApiResultStatus.ValidationFailed:
                _assignErrors = result.ValidationErrors;
                SetStatusCode(StatusCodes.Status400BadRequest);
                break;
            case ApiResultStatus.Conflict:
                _modified = true;
                break;
            default:
                await TryFailAsync(result);
                break;
        }

        if (!Redirected && !_missing && !Denied)
        {
            await LoadAsync();
        }
    }

    private async Task SaveOutcomeAsync()
    {
        var result = await Api.SetOpportunityOutcomeAsync(Token!, Id, Outcome.ToRequest());
        if (result.IsSuccess)
        {
            RedirectTo(ConversationsNotice.Url(Id, ConversationsNotice.OutcomeSaved));
            return;
        }

        switch (result.Status)
        {
            case ApiResultStatus.ValidationFailed:
                _outcomeErrors = result.ValidationErrors;
                SetStatusCode(StatusCodes.Status400BadRequest);
                break;
            case ApiResultStatus.Conflict:
                _modified = true;
                break;
            default:
                await TryFailAsync(result);
                break;
        }

        if (!Redirected && !_missing && !Denied)
        {
            await LoadAsync();
        }
    }
}
