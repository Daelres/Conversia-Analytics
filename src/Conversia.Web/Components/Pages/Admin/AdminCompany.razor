@page "/admin/empresas/{Id:guid}"
@attribute [Authorize(Policy = AuthenticationExtensions.AdminPolicy)]
@layout AdminLayout
@using Conversia.Application.DTOs.Admin
@using Conversia.Application.Time
@using Conversia.Domain.Enums
@using Conversia.Web.Authentication
@using Conversia.Web.Time
@inherits AdminPageBase
@inject TenantTimeZone TimeZone

<PageTitle>@(_company?.Name ?? "Empresa") - Administración de Conversia</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

@if (CompanyMissing)
{
    <CompanyNotFoundView />
}
else if (Denied)
{
    <ForbiddenView />
}
else if (!Redirected)
{
    <div class="page" data-page="admin-company" data-company-id="@Id">
        <PageHeader Eyebrow="Empresa" EyebrowIcon="building" Title="@(_company?.Name ?? "Empresa")"
                    Description="@(_company is null ? null : $"Registrada el {MetricsFormat.Date(DateOnly.FromDateTime(TimeZone.ToLocal(_company.RegisteredAt)))}.")">
            <a class="btn btn--secondary" href="/admin"><Icon Name="arrow-left" />Volver a empresas</a>
        </PageHeader>

        @if (Notice is not null && AdminNotice.Describe(Notice) is { } notice)
        {
            <Alert Kind="AlertKind.Success" data-testid="notice-success">@notice</Alert>
        }

        <ErrorAlert Message="@Message" />

        @if (_company is not null)
        {
            <Card Title="Estado" Subtitle="Si la empresa puede operar o no." IconName="shield-check" data-testid="status-card">
                <div class="stack">
                    <dl class="kv">
                        <div>
                            <dt>Estado ahora</dt>
                            <dd><TenantStatusChip Status="_company.Status" data-testid="company-status" /></dd>
                        </div>
                        @if (_company.StatusChangedAt is { } changedAt)
                        {
                            <div>
                                <dt>Último cambio</dt>
                                <dd data-testid="status-changed-at">@AdminFormat.Moment(TimeZone.ToLocal(changedAt))</dd>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_company.StatusReason))
                        {
                            <div>
                                <dt>Motivo</dt>
                                <dd data-testid="status-reason">@_company.StatusReason</dd>
                            </div>
                        }
                        @if (TenantStatusLabels.CauseLabel(_company.Status, _company.SuspensionCause) is { } cause)
                        {
                            <div>
                                <dt>Causa de la suspensión</dt>
                                <dd data-testid="suspension-cause" data-cause="@_company.SuspensionCause">@cause</dd>
                            </div>
                        }
                        @if (_company.CancelledAt is { } cancelledAt)
                        {
                            <div>
                                <dt>Cancelada el</dt>
                                <dd data-testid="cancelled-at">@AdminFormat.Moment(TimeZone.ToLocal(cancelledAt))</dd>
                            </div>
                        }
                        @if (_company.DataDeletionDueAt is { } dueAt && _company.DataDeletionStartedAt is null)
                        {
                            <div>
                                <dt>Eliminación de los datos</dt>
                                <dd data-testid="deletion-due-at">@AdminFormat.Moment(TimeZone.ToLocal(dueAt)) (puedes reactivarla antes)</dd>
                            </div>
                        }
                    </dl>
                    @if (_company.DataDeletionStartedAt is { } startedAt)
                    {
                        <Alert Kind="AlertKind.Warning" data-testid="deletion-in-progress">La eliminación de los datos empezó el @AdminFormat.Moment(TimeZone.ToLocal(startedAt)) y se hace en segundo plano. La empresa ya no se puede reactivar.</Alert>
                    }
                    <div class="cluster-md" data-testid="status-actions">
                        @foreach (var action in TenantStatusLabels.ActionsFor(_company))
                        {
                            <a class="@(action.Danger ? "btn btn--danger-ghost" : "btn btn--primary")" href="/admin/empresas/@Id/estado/@action.Route" data-action="@action.Route">
                                <Icon Name="@(action.Danger ? "power" : "check-circle")" />@action.Button
                            </a>
                        }
                        @if (_company.Status == TenantStatus.Cancelled && _company.DataDeletionStartedAt is null)
                        {
                            <a class="btn btn--danger-ghost" href="/admin/empresas/@Id/eliminar-datos" data-action="eliminar-datos"><Icon Name="trash" />Eliminar los datos ahora</a>
                        }
                    </div>
                    <p data-testid="company-billing"><a href="/admin/empresas/@Id/facturacion" data-testid="company-billing-link"><Icon Name="card" />Facturación: @BillingFormat.Subscription(_company.BillingStatus)</a></p>
                </div>
            </Card>

            <Card Title="Historial de estados" Subtitle="Altas, pausas, suspensiones, cancelaciones y eliminación de datos, del registro de auditoría." IconName="clock" data-testid="lifecycle-card">
                @if (_lifecycle is null)
                {
                    <p class="muted" data-testid="lifecycle-unavailable">No se pudo leer el historial ahora.</p>
                }
                else if (_lifecycle.Count == 0)
                {
                    <p class="muted" data-testid="lifecycle-empty">La empresa sigue como se registró.</p>
                }
                else
                {
                    <AuditList Entries="_lifecycle" Label="Historial de estados de la empresa" />
                }
            </Card>
        }

        @if (_company is not null)
        {
            <Card Title="Modo sandbox" Subtitle="Pruebas internas sin 360dialog: la empresa simula clientes y nada sale por WhatsApp." IconName="zap" data-testid="sandbox-card">
                <div class="stack">
                    <dl class="kv">
                        <div>
                            <dt>Modo sandbox ahora</dt>
                            <dd><Chip Tone="@(_company.SandboxMode ? ChipTone.Warning : ChipTone.Neutral)" IconName="@(_company.SandboxMode ? "zap" : "minus")" data-testid="company-sandbox" data-enabled="@(_company.SandboxMode ? "true" : "false")">@(_company.SandboxMode ? "Activado" : "Desactivado")</Chip></dd>
                        </div>
                    </dl>
                    <p class="muted">Mientras está activado, las métricas de la empresa muestran solo datos de prueba y sus mensajes no llegan a ningún teléfono. Cada cambio pide un motivo y queda en la auditoría.</p>
                    <div class="cluster-md" data-testid="sandbox-actions">
                        @if (_company.SandboxMode)
                        {
                            <a class="btn btn--primary" href="/admin/empresas/@Id/sandbox/@AdminSandboxAction.DisableRoute" data-action="@AdminSandboxAction.DisableRoute"><Icon Name="zap" />Desactivar el modo sandbox</a>
                        }
                        else
                        {
                            <a class="btn btn--secondary" href="/admin/empresas/@Id/sandbox/@AdminSandboxAction.EnableRoute" data-action="@AdminSandboxAction.EnableRoute"><Icon Name="zap" />Activar el modo sandbox</a>
                        }
                    </div>
                </div>
            </Card>
        }

        @* Always rendered: a POST can only be dispatched to a form that exists in the render tree. *@
        <Card Title="Cupo de líneas" Subtitle="Cuántas líneas de WhatsApp puede tener activas a la vez, según su acuerdo comercial." IconName="phone" data-testid="quota-card">
            <div class="stack">
                @if (_company is not null)
                {
                    <LineQuota Active="_company.ActiveLines" Max="_company.MaxActiveLines">
                        <p class="muted">Tiene @_company.RegisteredLines @(_company.RegisteredLines == 1 ? "línea registrada" : "líneas registradas"). Bajar el cupo por debajo de las líneas activas no es posible: primero hay que desactivarlas.</p>
                    </LineQuota>
                }

                @if (_quotaMessage is not null)
                {
                    <Alert Kind="AlertKind.Danger" data-testid="quota-error">@_quotaMessage</Alert>
                }

                <EditForm Model="Quota" FormName="set-quota" OnValidSubmit="SaveQuotaAsync" OnInvalidSubmit="LoadAsync" method="post" class="form" data-testid="quota-form">
                    <DataAnnotationsValidator />
                    <FormField TValue="string" For="() => Quota.MaxActiveLines" Id="quota" Label="Cupo de líneas activas" IconName="phone"
                               Hint="Un número entero de 0 a 1000." ApiErrors="_quotaErrors" Context="field">
                        <input id="quota" name="@($"{nameof(Quota)}.{nameof(QuotaInput.MaxActiveLines)}")" type="number" inputmode="numeric" min="0" max="@Conversia.Domain.Entities.Tenant.MaxLinesLimit" step="1"
                               class="input input--num" autocomplete="off" value="@(Quota.MaxActiveLines ?? _company?.MaxActiveLines.ToString())" @attributes="field" />
                    </FormField>
                    <ApiFieldErrors Errors="_quotaErrors" KnownFields="@(["MaxActiveLines"])" />
                    <div class="form-actions">
                        <button type="submit" class="btn btn--primary"><Icon Name="check" />Guardar cupo</button>
                    </div>
                </EditForm>
            </div>
        </Card>

        @* Always rendered, like the quota form: a POST can only be dispatched to a form that exists in the render tree. *@
        <Card Title="Límites" Subtitle="Lo que la empresa puede usar. Vacío = el valor por defecto de la plataforma." IconName="layers" data-testid="limits-card">
            <div class="stack">
                @if (_company is not null)
                {
                    <dl class="kv" data-testid="limits">
                        <div>
                            <dt>Cupo mensual de IA</dt>
                            <dd data-testid="limit-ai-quota" data-default="@(_company.Limits.AiQuotaIsDefault ? "true" : "false")">@MetricsFormat.Whole(_company.Limits.AiMonthlyConversationQuota) conversaciones (@AdminFormat.Origin(_company.Limits.AiQuotaIsDefault)) · tope @AdminFormat.Usd(_company.Limits.AiMonthlyUsdCeiling)</dd>
                        </div>
                        <div>
                            <dt>Envíos por minuto</dt>
                            <dd data-testid="limit-send-rate" data-default="@(_company.Limits.SendRateLimitIsDefault ? "true" : "false")">@MetricsFormat.Whole(_company.Limits.SendRateLimitPerMinute) (@AdminFormat.Origin(_company.Limits.SendRateLimitIsDefault))</dd>
                        </div>
                    </dl>
                }

                <EditForm Model="AiQuota" FormName="set-ai-quota" OnValidSubmit="SaveAiQuotaAsync" OnInvalidSubmit="LoadAsync" method="post" class="form" data-testid="ai-quota-form">
                    <DataAnnotationsValidator />
                    <FormField TValue="string" For="() => AiQuota.MonthlyConversations" Id="ai-quota" Label="Cupo mensual de conversaciones con IA" IconName="sparkles"
                               Hint="@AiQuotaHint" ApiErrors="_aiQuotaErrors" Context="field">
                        <input id="ai-quota" name="@($"{nameof(AiQuota)}.{nameof(AiQuotaInput.MonthlyConversations)}")" type="number" inputmode="numeric" min="0" max="@Conversia.Domain.Entities.Tenant.MaxAiMonthlyConversationQuota" step="1"
                               class="input input--num" autocomplete="off" value="@(AiQuota.MonthlyConversations ?? OwnAiQuota)" @attributes="field" />
                    </FormField>
                    <FormField TValue="string" For="() => AiQuota.Reason" Id="ai-quota-reason" Label="Motivo"
                               Hint="Obligatorio. Queda en la auditoría. No incluyas datos personales de clientes. Hasta 200 caracteres." ApiErrors="_aiQuotaErrors" Context="field">
                        <input id="ai-quota-reason" name="@($"{nameof(AiQuota)}.{nameof(AiQuotaInput.Reason)}")" class="input" maxlength="@Conversia.Domain.Entities.Tenant.AiChangeReasonMaxLength" autocomplete="off" value="@AiQuota.Reason" @attributes="field" />
                    </FormField>
                    <ApiFieldErrors Errors="_aiQuotaErrors" KnownFields="@(["MonthlyConversations", "Reason"])" />
                    <div class="form-actions">
                        <button type="submit" class="btn btn--secondary"><Icon Name="check" />Guardar cupo de IA</button>
                    </div>
                </EditForm>

                <EditForm Model="SendLimit" FormName="set-send-limit" OnValidSubmit="SaveSendLimitAsync" OnInvalidSubmit="LoadAsync" method="post" class="form" data-testid="send-limit-form">
                    <DataAnnotationsValidator />
                    <FormField TValue="string" For="() => SendLimit.PerMinute" Id="send-limit" Label="Límite de envíos por minuto" IconName="arrow-right"
                               Hint="@SendLimitHint" ApiErrors="_sendLimitErrors" Context="field">
                        <input id="send-limit" name="@($"{nameof(SendLimit)}.{nameof(SendLimitInput.PerMinute)}")" type="number" inputmode="numeric" min="1" max="@Conversia.Domain.Entities.Tenant.MaxSendRateLimitPerMinute" step="1"
                               class="input input--num" autocomplete="off" value="@(SendLimit.PerMinute ?? OwnSendLimit)" @attributes="field" />
                    </FormField>
                    <FormField TValue="string" For="() => SendLimit.Reason" Id="send-limit-reason" Label="Motivo"
                               Hint="Obligatorio. Queda en la auditoría. No incluyas datos personales de clientes. Hasta 200 caracteres." ApiErrors="_sendLimitErrors" Context="field">
                        <input id="send-limit-reason" name="@($"{nameof(SendLimit)}.{nameof(SendLimitInput.Reason)}")" class="input" maxlength="@Conversia.Domain.Entities.Tenant.AiChangeReasonMaxLength" autocomplete="off" value="@SendLimit.Reason" @attributes="field" />
                    </FormField>
                    <ApiFieldErrors Errors="_sendLimitErrors" KnownFields="@(["PerMinute", "Reason"])" />
                    <div class="form-actions">
                        <button type="submit" class="btn btn--secondary"><Icon Name="check" />Guardar límite de envíos</button>
                    </div>
                </EditForm>
            </div>
        </Card>

        @if (_company is not null)
        {
            <Card Title="Inteligencia artificial" Subtitle="Si el análisis con IA puede leer las conversaciones de la empresa." IconName="sparkles" data-testid="ai-card">
                <div class="stack">
                    <dl class="kv">
                        <div>
                            <dt>IA ahora</dt>
                            <dd><Chip Tone="@(_company.AiEnabled ? ChipTone.Success : ChipTone.Neutral)" IconName="@(_company.AiEnabled ? "sparkles" : "minus")" data-testid="company-ai" data-enabled="@(_company.AiEnabled ? "true" : "false")">@(_company.AiEnabled ? "Activada" : "Desactivada")</Chip></dd>
                        </div>
                        @if (_company.Limits.AiTermsVersion is { } terms)
                        {
                            <div>
                                <dt>Términos aceptados</dt>
                                <dd data-testid="ai-terms">@terms</dd>
                            </div>
                        }
                        @if (_monitoring is { } m)
                        {
                            <div>
                                <dt>Uso este mes</dt>
                                <dd data-testid="ai-usage" data-state="@m.Ai.State">@AdminFormat.AiState(m.Ai.State): @MetricsFormat.Whole(m.Ai.ThisMonth.Conversations) de @MetricsFormat.Whole(m.Ai.Quota) conversaciones · @AdminFormat.Usd(m.Ai.ThisMonth.EstimatedUsd) de @AdminFormat.Usd(m.Ai.CeilingUsd)</dd>
                            </div>
                            <div>
                                <dt>Sandbox este mes (no cuenta en el cupo)</dt>
                                <dd data-testid="ai-sandbox-usage">@MetricsFormat.Whole(m.Ai.SandboxThisMonth.Conversations) conversaciones · @AdminFormat.Usd(m.Ai.SandboxThisMonth.EstimatedUsd)</dd>
                            </div>
                        }
                    </dl>
                    <p class="muted">Activarla pide un motivo y la versión de los términos de IA que la empresa aceptó; ambos quedan en la auditoría.</p>
                    <div class="cluster-md" data-testid="ai-actions">
                        @if (_company.AiEnabled)
                        {
                            <a class="btn btn--secondary" href="/admin/empresas/@Id/ia/desactivar" data-action="desactivar"><Icon Name="power" />Desactivar la IA</a>
                        }
                        else
                        {
                            <a class="btn btn--primary" href="/admin/empresas/@Id/ia/activar" data-action="activar"><Icon Name="sparkles" />Activar la IA</a>
                        }
                    </div>
                </div>
            </Card>

            <Card Title="Licencias de 360dialog" Subtitle="Las licencias del inventario asignadas a esta empresa." IconName="key" data-testid="licenses-card">
                <div class="stack">
                    @if (_company.Licenses.Count == 0)
                    {
                        <p class="muted" data-testid="no-licenses">Sin licencias asignadas.</p>
                    }
                    else
                    {
                        <ul class="stack" data-testid="license-list">
                            @foreach (var license in _company.Licenses)
                            {
                                <li data-testid="license-item" data-license-id="@license.Id">
                                    <a href="/admin/licencias/@license.Id">@license.PhoneNumberMasked</a>
                                    <span class="muted">· @(license.ChannelId is null ? "sin línea vinculada" : "vinculada a una línea") · @(license.CustomerOwned ? "del cliente" : AdminFormat.Usd(license.MonthlyCostUsd) + " al mes")</span>
                                </li>
                            }
                        </ul>
                    }
                    <div class="cluster-md">
                        <a class="btn btn--secondary" href="/admin/licencias?estado=disponible"><Icon Name="key" />Asignar una licencia</a>
                    </div>
                </div>
            </Card>

            <Card Title="Monitoreo" Subtitle="Cómo le funciona el servicio a esta empresa. Solo cifras: ningún mensaje ni dato de sus clientes." IconName="bar-chart" data-testid="monitoring-card">
                @if (_monitoring is not { } mon)
                {
                    <p class="muted" data-testid="monitoring-unavailable">El monitoreo no está disponible en este momento.</p>
                }
                else
                {
                    <div class="stack">
                        <dl class="kv">
                            <div><dt>Líneas activas</dt><dd>@AdminFormat.LinesOfQuota(mon.ActiveLines, mon.MaxActiveLines) · @MetricsFormat.Whole(mon.AssignedLicenses) @(mon.AssignedLicenses == 1 ? "licencia" : "licencias")</dd></div>
                            <div><dt>Última entrega real</dt><dd data-testid="last-delivery">@(mon.LastRealDeliveryAt is { } at ? AdminFormat.Moment(TimeZone.ToLocal(at)) : AdminFormat.NoActivity)</dd></div>
                            <div><dt>Pendiente</dt><dd>@MetricsFormat.Whole(mon.Backlog.WebhookPending) entregas · @MetricsFormat.Whole(mon.Backlog.ClassificationWaiting) clasificaciones · @MetricsFormat.Whole(mon.Backlog.ClassificationStopped) detenidas</dd></div>
                            <div><dt>Errores (24 h)</dt><dd>@MetricsFormat.Whole(mon.Errors.Last24h)</dd></div>
                            <div><dt>Envíos reales (7 días)</dt><dd>@MetricsFormat.Whole(mon.Sends.RealLast7d) · no salieron @MetricsFormat.Whole(mon.Sends.RealFailedLast7d)</dd></div>
                        </dl>
                        <div class="table-wrap" role="region" aria-label="Entregas del webhook de la empresa" tabindex="0">
                            <table class="table">
                                <caption class="sr-only">Entregas del webhook de la empresa por ventana</caption>
                                <thead>
                                    <tr><th scope="col">Ventana</th><th scope="col">Entregas</th><th scope="col">Mensajes guardados</th><th scope="col">Duplicados</th><th scope="col">Omitidos</th><th scope="col">Fallidas</th></tr>
                                </thead>
                                <tbody>
                                    <DeliveryRow Label="Reales, últimas 24 h" Counts="mon.Deliveries.RealLast24h" />
                                    <DeliveryRow Label="Reales, últimos 7 días" Counts="mon.Deliveries.RealLast7d" />
                                    <DeliveryRow Label="Sandbox, últimos 7 días" Counts="mon.Deliveries.SandboxLast7d" />
                                </tbody>
                            </table>
                        </div>
                        @if (mon.Days.Count > 0)
                        {
                            <div class="table-wrap" role="region" aria-label="Actividad diaria de la empresa" tabindex="0">
                                <table class="table" data-testid="daily-table">
                                    <caption class="sr-only">Mensajes y conversaciones por día (últimos 14 días)</caption>
                                    <thead>
                                        <tr><th scope="col">Día</th><th scope="col">Datos</th><th scope="col">Mensajes recibidos</th><th scope="col">Mensajes enviados</th><th scope="col">Conversaciones abiertas</th><th scope="col">Conversaciones cerradas</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var day in mon.Days.OrderByDescending(d => d.Day).ThenBy(d => d.IsSandbox))
                                        {
                                            <tr data-testid="day-row" data-day="@day.Day" data-sandbox="@(day.IsSandbox ? "true" : "false")">
                                                <th scope="row">@DayLabel(day.Day)</th>
                                                <td>@(day.IsSandbox ? "Sandbox" : "Reales")</td>
                                                <td>@MetricsFormat.Whole(day.MessagesIn)</td>
                                                <td>@MetricsFormat.Whole(day.MessagesOut)</td>
                                                <td>@MetricsFormat.Whole(day.ConversationsOpened)</td>
                                                <td>@MetricsFormat.Whole(day.ConversationsClosed)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                }
            </Card>
        }

        @if (_company is not null)
        {
            <Card Title="Líneas" Subtitle="Los números de WhatsApp que la empresa ha registrado." IconName="phone" data-testid="lines-card">
                @if (_company.Lines.Count == 0)
                {
                    <EmptyState Title="Aún no hay líneas" Art="chat" Text="La empresa todavía no ha registrado ningún número de WhatsApp." />
                }
                else
                {
                    <div class="table-wrap" role="region" aria-label="Líneas de la empresa" tabindex="0">
                        <table class="table table--cards">
                            <caption class="sr-only">Líneas de WhatsApp de la empresa</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Número</th>
                                    <th scope="col">Sucursal</th>
                                    <th scope="col">Estado</th>
                                    <th scope="col"><span class="sr-only">Acciones</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in _company.Lines)
                                {
                                    <tr data-testid="line-row" data-channel-id="@line.ChannelId" data-active="@(line.IsActive ? "true" : "false")">
                                        <th scope="row" data-label="Número" id="ln-@line.ChannelId">@line.DisplayPhoneNumber</th>
                                        <td data-label="Sucursal">@(line.BranchName ?? MetricsFormat.NoData)</td>
                                        <td data-label="Estado"><Chip Tone="@(line.IsActive ? ChipTone.Success : ChipTone.Neutral)" IconName="@(line.IsActive ? "check-circle" : "minus")">@(line.IsActive ? "Activa" : "Inactiva")</Chip></td>
                                        <td class="table__cell-actions">
                                            <div class="table__actions">
                                                @if (line.IsActive)
                                                {
                                                    <a href="/admin/empresas/@Id/lineas/@line.ChannelId/desactivar" id="ld-@line.ChannelId" class="btn btn--danger-ghost btn--sm" aria-labelledby="ld-@line.ChannelId ln-@line.ChannelId"><Icon Name="power" Class="icon--sm" />Desactivar</a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </Card>

            <Card Title="Datos de la empresa" IconName="building" data-testid="facts-card">
                <dl class="kv">
                    <div>
                        <dt>Propietario</dt>
                        <dd data-testid="owner-email">@(_company.OwnerEmail ?? MetricsFormat.NoData)</dd>
                    </div>
                    <div>
                        <dt>Última actividad</dt>
                        <dd data-testid="last-activity">@(_company.LastActivityAt is { } last ? AdminFormat.Moment(TimeZone.ToLocal(last)) : AdminFormat.NoActivity)</dd>
                    </div>
                </dl>
                <p class="muted">Aquí solo ves datos de negocio. Las conversaciones, los mensajes y las métricas de la empresa no se muestran a la administración.</p>
            </Card>

            <Card Title="Cambios recientes" Subtitle="Lo último que se hizo con esta empresa." IconName="activity" data-testid="audit-card">
                <div class="stack">
                    @if (_company.RecentAudit.Count == 0)
                    {
                        <EmptyState Title="Sin cambios todavía" Art="chat" Text="Cuando actives, suspendas o cambies el cupo de la empresa, quedará aquí." />
                    }
                    else
                    {
                        <AuditList Entries="_company.RecentAudit" Label="Cambios recientes de la empresa" />
                        <div class="cluster-md">
                            <a class="btn btn--secondary" href="/admin/auditoria?empresa=@Id"><Icon Name="activity" />Ver todo el registro</a>
                        </div>
                    }
                </div>
            </Card>
        }
    </div>
}

@code {
    private TenantDetailResponse? _company;
    private string? _quotaMessage;
    private IReadOnlyDictionary<string, string[]>? _quotaErrors;
    private QuotaInput? _quota;
    private TenantMonitoringResponse? _monitoring;
    private IReadOnlyList<AuditEntryResponse>? _lifecycle;
    private AiQuotaInput? _aiQuota;
    private SendLimitInput? _sendLimit;
    private IReadOnlyDictionary<string, string[]>? _aiQuotaErrors;
    private IReadOnlyDictionary<string, string[]>? _sendLimitErrors;

    [SupplyParameterFromForm(FormName = "set-ai-quota")]
    private AiQuotaInput AiQuota
    {
        get => _aiQuota ??= new();
        set => _aiQuota = value;
    }

    [SupplyParameterFromForm(FormName = "set-send-limit")]
    private SendLimitInput SendLimit
    {
        get => _sendLimit ??= new();
        set => _sendLimit = value;
    }

    // The company's own values, empty when it uses the default (so saving the form unchanged keeps the default).
    private string? OwnAiQuota => _company is { Limits.AiQuotaIsDefault: false } c ? c.Limits.AiMonthlyConversationQuota.ToString(System.Globalization.CultureInfo.InvariantCulture) : null;

    private string? OwnSendLimit => _company is { Limits.SendRateLimitIsDefault: false } c ? c.Limits.SendRateLimitPerMinute.ToString(System.Globalization.CultureInfo.InvariantCulture) : null;

    private string AiQuotaHint => _company is null
        ? "Un número entero de 0 a 1.000.000; vacío para el valor por defecto."
        : $"Un número entero de 0 a 1.000.000; vacío para el valor por defecto ({MetricsFormat.Whole(_company.Limits.DefaultAiMonthlyConversationQuota)}). Cuenta conversaciones distintas por mes.";

    private string SendLimitHint => _company is null
        ? "Un número entero mayor que 0; vacío para el valor por defecto."
        : $"Un número entero de 1 a {MetricsFormat.Whole(_company.Limits.MaxSendRateLimitPerMinute)}; vacío para el valor por defecto ({MetricsFormat.Whole(_company.Limits.DefaultSendRateLimitPerMinute)}). Suma los envíos de todos sus usuarios.";

    private static string DayLabel(string day)
        => DateOnly.TryParseExact(day, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var date) ? MetricsFormat.Day(date) : day;

    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromQuery(Name = "aviso")]
    public string? Notice { get; set; }

    [SupplyParameterFromForm(FormName = "set-quota")]
    private QuotaInput Quota
    {
        get => _quota ??= new();
        set => _quota = value;
    }

    protected override async Task OnInitializedAsync()
    {
        if (!await TryReadTokenAsync())
        {
            return;
        }

        if (!IsPost)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        var detailTask = Api.GetAdminTenantAsync(Token!, Id);
        var monitoringTask = Api.GetAdminTenantMonitoringAsync(Token!, Id);
        var lifecycleTask = Api.GetAdminTenantLifecycleAsync(Token!, Id);
        await Task.WhenAll(detailTask, monitoringTask, lifecycleTask);
        if (await TryFailAsync(detailTask.Result))
        {
            return;
        }

        _company = detailTask.Result.Value;
        // The monitoring and the history are sections of the page: if they cannot be read, the rest still works.
        _monitoring = monitoringTask.Result.IsSuccess ? monitoringTask.Result.Value : null;
        _lifecycle = lifecycleTask.Result.IsSuccess ? lifecycleTask.Result.Value!.Items : null;
    }

    private async Task SaveAiQuotaAsync()
    {
        var result = await Api.SetTenantAiQuotaAsync(Token!, Id, AiQuota.ToRequest());
        await AfterLimitAsync(result, AdminNotice.AiQuotaSaved, errors => _aiQuotaErrors = errors);
    }

    private async Task SaveSendLimitAsync()
    {
        var result = await Api.SetTenantSendRateLimitAsync(Token!, Id, SendLimit.ToRequest());
        await AfterLimitAsync(result, AdminNotice.SendLimitSaved, errors => _sendLimitErrors = errors);
    }

    private async Task AfterLimitAsync(ApiResult<TenantSummaryResponse> result, string notice, Action<IReadOnlyDictionary<string, string[]>?> showErrors)
    {
        if (result.IsSuccess)
        {
            RedirectTo(AdminNotice.Url(Id, notice));
            return;
        }

        if (result.Status == ApiResultStatus.ValidationFailed)
        {
            showErrors(result.ValidationErrors);
            SetStatusCode(StatusCodes.Status400BadRequest);
        }
        else
        {
            await TryFailAsync(result);
        }

        if (!Redirected && !Denied && !CompanyMissing)
        {
            await LoadAsync();
        }
    }

    private async Task SaveQuotaAsync()
    {
        var result = await Api.SetTenantLineQuotaAsync(Token!, Id, Quota.ToRequest());
        if (result.IsSuccess)
        {
            RedirectTo(AdminNotice.Url(Id, AdminNotice.QuotaSaved));
            return;
        }

        switch (result.Status)
        {
            case ApiResultStatus.ValidationFailed:
                _quotaErrors = result.ValidationErrors;
                SetStatusCode(StatusCodes.Status400BadRequest);
                break;
            case ApiResultStatus.Conflict:
                // The API says how many lines are active; that is the message the administrator needs.
                _quotaMessage = result.Detail ?? "No se puede guardar ese cupo.";
                SetStatusCode(StatusCodes.Status409Conflict);
                break;
            default:
                await TryFailAsync(result);
                break;
        }

        if (!Redirected && !Denied && !CompanyMissing)
        {
            await LoadAsync();
        }
    }
}
