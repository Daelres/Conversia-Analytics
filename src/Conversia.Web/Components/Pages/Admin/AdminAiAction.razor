@page "/admin/empresas/{Id:guid}/ia/{Action}"
@attribute [Authorize(Policy = AuthenticationExtensions.AdminPolicy)]
@layout AdminLayout
@using Conversia.Application.DTOs.Admin
@using Conversia.Domain.Entities
@using Conversia.Web.Authentication
@inherits AdminPageBase

<PageTitle>@Title - Administración de Conversia</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

@if (Enable is null || CompanyMissing)
{
    <CompanyNotFoundView />
}
else if (Denied)
{
    <ForbiddenView />
}
else if (!Redirected)
{
    <div class="page page--narrow" data-page="admin-ai-action" data-action="@Action" data-company-id="@Id">
        <PageHeader Eyebrow="Empresa" EyebrowIcon="building" Title="@Title" Description="@(_company?.Name)">
            <a class="btn btn--secondary" href="/admin/empresas/@Id"><Icon Name="arrow-left" />Volver a la empresa</a>
        </PageHeader>

        <ErrorAlert Message="@Message" />

        @if (_company is not null && !Applies)
        {
            <Alert Kind="AlertKind.Warning" data-testid="not-allowed">Esta acción no aplica ahora: la IA de la empresa ya está @(_company.AiEnabled ? "activada" : "desactivada"). Vuelve a la empresa para ver lo que puedes hacer.</Alert>
        }

        @* Always rendered (hidden when it does not apply): a POST can only be dispatched to a form that exists in the render tree,
           and a forged one must still reach the API and be refused there. *@
        <div hidden="@(!ShowForm)">
            <Card Title="@Question" IconName="sparkles" data-testid="ai-confirm">
                <div class="stack">
                    <dl class="kv">
                        <div>
                            <dt>IA ahora</dt>
                            <dd>@(_company is null ? MetricsFormat.NoData : _company.AiEnabled ? "Activada" : "Desactivada")</dd>
                        </div>
                        <div>
                            <dt>Quedará</dt>
                            <dd>@(Enable == true ? "Activada" : "Desactivada")</dd>
                        </div>
                    </dl>
                    <p class="muted" data-testid="confirm-effect">@Effect</p>
                    <EditForm Model="Input" FormName="ai-action" OnValidSubmit="RunAsync" OnInvalidSubmit="LoadAsync" method="post" class="form" data-testid="ai-action-form">
                        <DataAnnotationsValidator />
                        <FormField TValue="string" For="() => Input.Reason" Id="reason" Label="Motivo"
                                   Hint="Obligatorio. Queda en el registro de auditoría. No incluyas datos personales de clientes. Hasta 200 caracteres." ApiErrors="_errors" Context="field">
                            <textarea id="reason" name="@($"{nameof(Input)}.{nameof(AiSwitchInput.Reason)}")" class="input" rows="3" maxlength="@Tenant.AiChangeReasonMaxLength" @attributes="field">@Input.Reason</textarea>
                        </FormField>
                        @if (Enable == true)
                        {
                            <FormField TValue="string" For="() => Input.TermsVersion" Id="terms" Label="Versión de los términos aceptados"
                                       Hint="Obligatoria para activar: la versión de los términos de IA que la empresa aceptó (por ejemplo «ia-2026-11»). Queda como evidencia en la auditoría." ApiErrors="_errors" Context="field">
                                <input id="terms" name="@($"{nameof(Input)}.{nameof(AiSwitchInput.TermsVersion)}")" class="input" maxlength="@Tenant.AiTermsVersionMaxLength" autocomplete="off" value="@Input.TermsVersion" @attributes="field" />
                            </FormField>
                        }
                        <ApiFieldErrors Errors="_errors" KnownFields="@(["Reason", "TermsVersion"])" />
                        <div class="form-actions">
                            @if (ShowForm)
                            {
                                <button type="submit" class="btn btn--primary" data-testid="ai-action-submit"><Icon Name="sparkles" />@Confirm</button>
                            }
                            <a class="btn btn--ghost" href="/admin/empresas/@Id">Cancelar</a>
                        </div>
                    </EditForm>
                </div>
            </Card>
        </div>
    </div>
}

@code {
    public const string EnableRoute = "activar";
    public const string DisableRoute = "desactivar";

    private TenantDetailResponse? _company;
    private IReadOnlyDictionary<string, string[]>? _errors;
    private AiSwitchInput? _input;

    [Parameter]
    public Guid Id { get; set; }

    [Parameter]
    public string Action { get; set; } = string.Empty;

    [SupplyParameterFromForm(FormName = "ai-action")]
    private AiSwitchInput Input
    {
        get => _input ??= new();
        set => _input = value;
    }

    /// <summary>What the address asks for; null for an address that is neither.</summary>
    private bool? Enable => Action switch
    {
        EnableRoute => true,
        DisableRoute => false,
        _ => null,
    };

    private string Title => Enable == false ? "Desactivar la IA" : "Activar la IA";

    private string Question => Enable == false ? "¿Desactivar la IA de esta empresa?" : "¿Activar la IA de esta empresa?";

    private string Confirm => Enable == false ? "Sí, desactivar la IA" : "Sí, activar la IA";

    private string Effect => Enable == false
        ? "Las próximas conversaciones de la empresa se clasifican solo con reglas. Lo ya analizado se conserva."
        : "Las próximas conversaciones de la empresa se analizan con IA (texto seudonimizado, procesado por un proveedor de IA), dentro de su cupo mensual y su tope en USD. Hazlo solo si la empresa aceptó los términos de IA.";

    // The page offers the form only when it would change something; the API accepts the same value again and writes nothing.
    private bool Applies => _company is not null && Enable is { } enable && _company.AiEnabled != enable;

    private bool ShowForm => Applies && !Redirected;

    protected override async Task OnInitializedAsync()
    {
        if (Enable is null)
        {
            NotFoundInPlace();
            return;
        }

        if (!await TryReadTokenAsync())
        {
            return;
        }

        if (!IsPost)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        var result = await Api.GetAdminTenantAsync(Token!, Id);
        if (await TryFailAsync(result))
        {
            return;
        }

        _company = result.Value;
    }

    private async Task RunAsync()
    {
        var enable = Enable!.Value;
        if (enable && string.IsNullOrWhiteSpace(Input.TermsVersion))
        {
            _errors = new Dictionary<string, string[]> { ["TermsVersion"] = [Tenant.AiTermsVersionRuleMessage] };
            SetStatusCode(StatusCodes.Status400BadRequest);
            await LoadAsync();
            return;
        }

        var result = await Api.SetTenantAiEnabledAsync(Token!, Id, Input.ToRequest(enable));
        if (result.IsSuccess)
        {
            RedirectTo(AdminNotice.Url(Id, enable ? AdminNotice.AiOn : AdminNotice.AiOff));
            return;
        }

        if (result.Status == ApiResultStatus.ValidationFailed)
        {
            _errors = result.ValidationErrors;
            SetStatusCode(StatusCodes.Status400BadRequest);
        }
        else
        {
            await TryFailAsync(result);
        }

        if (!Redirected && !Denied && !CompanyMissing)
        {
            await LoadAsync();
        }
    }
}
