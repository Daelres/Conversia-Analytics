@page "/organizacion/canales/{Id:guid}/clave-api"
@attribute [Authorize]
@using Conversia.Application.DTOs.Organization
@using Conversia.Application.Time
@using Conversia.Domain.Enums
@using Conversia.Web.Http
@using Conversia.Web.Time
@inherits AuthenticatedPageBase
@inject TenantTimeZone TimeZone

<PageTitle>Clave de API del proveedor - Conversia</PageTitle>

@if (Denied)
{
    <ForbiddenView />
}
else if (_missing)
{
    <ChannelNotFoundView />
}
else if (!Redirected)
{
    <div class="page page--narrow" data-page="channel-credentials">
        <PageHeader Eyebrow="Organización" EyebrowIcon="building" Title="Clave de API del proveedor"
                    Description="La clave de 360dialog con la que este número envía mensajes de WhatsApp.">
            <a class="btn btn--secondary" href="/organizacion"><Icon Name="arrow-left" />Volver a organización</a>
        </PageHeader>

        <ErrorAlert Message="@Message" />

        @* Always rendered: a POST can only be dispatched to a form that exists in the render tree, and a caller
           without OrganizationManage who forges one must still reach the API and be refused there, not crash here. *@
        <div hidden="@(!ShowForm)">
            <div class="stack">
                <Card Title="@(HasKey ? "Reemplazar la clave o cambiar el entorno" : "Configurar la clave")" IconName="lock" data-testid="credentials-card">
                    <div class="stack">
                        <dl class="kv">
                            <div>
                                <dt>Número</dt>
                                <dd data-testid="credentials-number">@_channel?.DisplayPhoneNumber</dd>
                            </div>
                            <div>
                                <dt>Clave de API</dt>
                                <dd data-testid="credentials-state">@KeyState</dd>
                            </div>
                            <div>
                                <dt>Entorno actual</dt>
                                <dd>@MessagingLabels.Environment(_channel?.ProviderEnvironment)</dd>
                            </div>
                        </dl>
                        <p class="muted">Conversia guarda la clave cifrada y no la vuelve a mostrar: ni en esta página ni en ninguna otra. Si la pierdes, pide una nueva en 360dialog y escríbela aquí.</p>
                        <EditForm Model="Input" FormName="save-credentials" OnValidSubmit="SaveAsync" OnInvalidSubmit="ReloadAsync" method="post" class="form" autocomplete="off" data-testid="credentials-form">
                            <DataAnnotationsValidator />
                            <FormField TValue="string" For="() => Input.ApiKey" Id="credentials-key" Label="@(HasKey ? "Clave de API nueva" : "Clave de API")" IconName="lock"
                                       Hint="@(HasKey ? "Déjalo vacío para conservar la clave guardada y cambiar solo el entorno." : "La clave que 360dialog entrega para este número (en el sandbox, la que llega al enviar START).")"
                                       ApiErrors="_errors" Context="field">
                                @* A plain input on purpose: it is never bound back, so the key a person typed is not written into the answer, valid or not. *@
                                <input type="password" id="credentials-key" class="input input--mono" autocomplete="off" autocapitalize="off" spellcheck="false" maxlength="256"
                                       name="@($"{nameof(Input)}.{nameof(ProviderCredentialsInput.ApiKey)}")" @attributes="field" />
                            </FormField>
                            <FormField TValue="string" For="() => Input.Environment" Id="credentials-environment" Label="Entorno" ApiErrors="_errors"
                                       Hint="Sandbox es el entorno de pruebas de 360dialog: solo escribe al número vinculado a la clave y admite 25 solicitudes en total. Producción es la línea real." Context="field">
                                <InputSelect id="credentials-environment" class="input" name="@($"{nameof(Input)}.{nameof(ProviderCredentialsInput.Environment)}")" @bind-Value="Input.Environment" @attributes="field">
                                    @foreach (var environment in MessagingLabels.Environments)
                                    {
                                        <option value="@environment">@MessagingLabels.Environment(environment)</option>
                                    }
                                </InputSelect>
                            </FormField>
                            <ApiFieldErrors Errors="_errors" KnownFields="@(["ApiKey", "Environment"])" />
                            <div class="form-actions">
                                @if (ShowForm)
                                {
                                    <button type="submit" class="btn btn--primary"><Icon Name="check" />@(HasKey ? "Guardar cambios" : "Guardar clave")</button>
                                }
                                <a class="btn btn--ghost" href="/organizacion">Cancelar</a>
                            </div>
                        </EditForm>
                    </div>
                </Card>

                @if (HasKey)
                {
                    <Card Title="Quitar la clave" Subtitle="El número deja de poder enviar mensajes; recibirlos no cambia." IconName="trash" data-testid="credentials-remove">
                        <div class="form-actions">
                            <a class="btn btn--danger-ghost" href="/organizacion/canales/@Id/quitar-clave"><Icon Name="trash" />Quitar la clave de API</a>
                        </div>
                    </Card>
                }
            </div>
        </div>
    </div>
}

@code {
    private ChannelResponse? _channel;
    private bool _missing;
    private bool _canManage;
    private IReadOnlyDictionary<string, string[]>? _errors;
    private ProviderCredentialsInput? _input;

    [SupplyParameterFromForm(FormName = "save-credentials")]
    private ProviderCredentialsInput Input
    {
        get => _input ??= new();
        set => _input = value;
    }

    [Parameter]
    public Guid Id { get; set; }

    private bool HasKey => _channel?.HasProviderApiKey == true;

    private bool ShowForm => _channel is not null && _canManage && !Redirected;

    private string KeyState => _channel switch
    {
        { HasProviderApiKey: true, ProviderApiKeySetAt: { } setAt } => $"Configurada el {MetricsFormat.Date(DateOnly.FromDateTime(TimeZone.ToLocal(setAt)))}",
        { HasProviderApiKey: true } => "Configurada",
        _ => "Sin clave",
    };

    protected override async Task OnInitializedAsync()
    {
        if (!await TryReadTokenAsync())
        {
            return;
        }

        if (!IsPost)
        {
            await LoadAsync();
        }
    }

    protected override void OnNotFound()
    {
        _missing = true;
        NotFoundMarker.Mark(HttpContext, NotFoundMarker.Channel);
        SetStatusCode(StatusCodes.Status404NotFound);
        Message = null;
    }

    private Task ReloadAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var channelTask = Api.GetChannelAsync(Token!, Id);
        var profileTask = Api.GetMyProfileAsync(Token!);
        await Task.WhenAll(channelTask, profileTask);

        if (await TryFailAsync(channelTask.Result, profileTask.Result))
        {
            return;
        }

        Shell.Remember(profileTask.Result.Value!);
        _channel = channelTask.Result.Value;
        _canManage = profileTask.Result.Value!.Can(Permission.OrganizationManage);
        if (!_canManage)
        {
            Deny();
            return;
        }

        // The environment the line has now is the one offered first; what a person chose and posted is kept.
        if (!IsPost)
        {
            Input.Environment = _channel!.ProviderEnvironment;
        }
    }

    private async Task SaveAsync()
    {
        var result = await Api.SetProviderCredentialsAsync(Token!, Id, Input.ToRequest());
        if (result.IsSuccess)
        {
            // Post/redirect/get with a fixed code: the key travels in no address and is in no page.
            RedirectTo(OrganizationNotice.Url(Input.KeyGiven ? OrganizationNotice.ProviderKeySet : OrganizationNotice.ProviderEnvironmentSet));
            return;
        }

        switch (result.Status)
        {
            case ApiResultStatus.ValidationFailed:
                _errors = result.ValidationErrors;
                SetStatusCode(StatusCodes.Status400BadRequest);
                break;
            case ApiResultStatus.Unavailable when result.ProblemCode == SendFailure.CredentialsUnavailable:
                Message = SendFailure.CredentialsUnavailableMessage;
                SetStatusCode(StatusCodes.Status503ServiceUnavailable);
                break;
            default:
                await TryFailAsync(result);
                break;
        }

        if (!Redirected && !_missing && !Denied)
        {
            await LoadAsync();
        }
    }
}
