@inherits LayoutComponentBase
@implements IDisposable
@inject ShellState Shell

@if (AdministrationNotFound)
{
    @* The page of a company that does not exist is answered through the generic not-found route: it keeps the administrator's own shell. *@
    <AdminLayout Body="Body" />
}
else
{
    <InPageLink Fragment="main" class="skip-link">Saltar al contenido</InPageLink>
    <div class="shell" data-shell="@(_signedIn ? "app" : "site")">
        <ShellHeader SignedIn="_signedIn" Profile="Shell.User" Tenant="Shell.Tenant" />
        <div class="shell-body">
            <main id="main" tabindex="-1">
                @if (_signedIn && Shell.User?.SandboxMode == true)
                {
                    @* On every page of a company in sandbox mode (docs/SANDBOX.md), above everything else, so nobody takes test numbers for real ones. *@
                    <div class="sandbox-banner" role="status" data-testid="sandbox-banner">
                        <Icon Name="alert-triangle" />
                        <p><strong>Modo sandbox activo.</strong> Tu empresa está en el modo de pruebas interno de Conversia: no se envía ningún mensaje real por WhatsApp y el panel muestra solo datos de prueba. Los mensajes reales que lleguen se siguen guardando.</p>
                    </div>
                }
                <ErrorCodeNotice />
                @Body
            </main>
            <SiteFooter />
        </div>
    </div>
}

@code {
    private bool _signedIn;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private bool AdministrationNotFound => Http.NotFoundMarker.IsMarked(HttpContext, Http.NotFoundMarker.Company);

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Shell.Changed += OnShellChanged;
        if (AuthenticationState is not null)
        {
            var user = (await AuthenticationState).User;
            _signedIn = user.Identity?.IsAuthenticated == true;
        }
    }

    private void OnShellChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Shell.Changed -= OnShellChanged;
}
