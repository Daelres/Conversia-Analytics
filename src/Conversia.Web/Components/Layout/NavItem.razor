@inject NavigationManager Navigation

<li>
    @if (Locked)
    {
        @* Not a link: the page needs an active company. aria-disabled and the lock icon say so without relying on colour. *@
        <span class="nav-link nav-link--locked" aria-disabled="true" data-locked="true">
            <Icon Name="@IconName" />
            <span>@Label</span>
            <Icon Name="lock" Class="nav-link__lock icon--sm" />
            <span class="sr-only">(disponible cuando tu empresa esté activa)</span>
        </span>
    }
    else
    {
        <a class="@CssClass" href="@Href" aria-current="@(IsCurrent ? "page" : null)">
            <Icon Name="@IconName" />
            <span>@Label</span>
        </a>
    }
</li>

@code {
    [Parameter]
    public string Href { get; set; } = "/";

    /// <summary>Shown but not available yet (the company is not active): rendered without a link.</summary>
    [Parameter]
    public bool Locked { get; set; }

    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string IconName { get; set; } = string.Empty;

    /// <summary>The home entry is current only on "/" itself; the others also cover the pages below them (/conversaciones/{id}).</summary>
    [Parameter]
    public bool Exact { get; set; }

    /// <summary>A prefix that also makes this entry current (the pages below the list it opens), for a list whose own path is a prefix of its sibling's.</summary>
    [Parameter]
    public string? AlsoUnder { get; set; }

    /// <summary>Styled as the call to action of the bar.</summary>
    [Parameter]
    public bool Cta { get; set; }

    private string CssClass => Cta ? "nav-link nav-link--cta" : "nav-link";

    private bool IsCurrent
    {
        get
        {
            var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
            if (AlsoUnder is not null && path.StartsWith(AlsoUnder + "/", StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }

            return Exact
                ? string.Equals(path, Href, StringComparison.OrdinalIgnoreCase)
                : string.Equals(path, Href, StringComparison.OrdinalIgnoreCase) || path.StartsWith(Href + "/", StringComparison.OrdinalIgnoreCase);
        }
    }
}
