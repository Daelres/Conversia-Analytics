@inherits LayoutComponentBase

<InPageLink Fragment="main" class="skip-link">Saltar al contenido</InPageLink>
<div class="auth">
    <aside class="auth-brand">
        <a class="brand brand--light" href="/">
            <BrandMark Class="brandmark--on-dark brandmark--lg" />
            <span class="brand-name">Conversia</span>
        </a>
        <div class="auth-brand__copy">
            <p class="auth-brand__title">Tu espacio de trabajo, listo para crecer.</p>
            <ul class="benefits">
                <li><Icon Name="building" /><span>Cada equipo trabaja en su propio espacio, aislado del resto.</span></li>
                <li><Icon Name="shield-check" /><span>Permisos claros: cada persona ve y hace solo lo que le corresponde.</span></li>
                <li><Icon Name="zap" /><span>Una base moderna en .NET 10 para empezar a construir hoy.</span></li>
            </ul>
        </div>
        <p class="auth-brand__foot">Plantilla multiespacio con API protegida y Blazor.</p>
    </aside>
    <div class="shell auth-shell" data-shell="site">
        <ShellHeader SignedIn="false" />
        <div class="shell-body">
            <main id="main" tabindex="-1">
                <ErrorCodeNotice />
                @Body
            </main>
        </div>
    </div>
</div>
