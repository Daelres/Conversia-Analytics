@inherits LayoutComponentBase

<InPageLink Fragment="main" class="skip-link">Saltar al contenido</InPageLink>
<div class="auth">
    <aside class="auth-brand">
        <a class="brand brand--light" href="/">
            <BrandMark Class="brandmark--on-dark brandmark--lg" />
            <span class="brand-name">Conversia</span>
        </a>
        <div class="auth-brand__copy">
            <p class="auth-brand__title">Entiende por qué tus clientes no compran.</p>
            <ul class="benefits">
                <li><Icon Name="message" /><span>Leemos tus conversaciones de WhatsApp en segundo plano, sin cambiar cómo responden tus asesores.</span></li>
                <li><Icon Name="bar-chart" /><span>Un panel con conversión, tiempos de respuesta y motivos de no cierre.</span></li>
                <li><Icon Name="shield-check" /><span>Datos separados por empresa y permisos por rol.</span></li>
            </ul>
        </div>
        <p class="auth-brand__foot">Versión de prueba: el piloto aún se está construyendo.</p>
    </aside>
    <div class="shell auth-shell" data-shell="site">
        <ShellHeader SignedIn="false" />
        <div class="shell-body">
            <main id="main" tabindex="-1">
                <ErrorCodeNotice />
                @Body
            </main>
        </div>
    </div>
</div>
