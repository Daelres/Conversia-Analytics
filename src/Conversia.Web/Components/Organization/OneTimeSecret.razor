@using Conversia.Application.DTOs.Organization
@* The webhook address and secret of a channel, shown this once. Nothing here is stored by the Web: the answer that carries it is not cached, not redirected and not logged. *@
<section class="secret" data-testid="channel-secret" aria-labelledby="secret-title">
    <div class="secret__head">
        <span class="tile-icon tile-icon--accent"><Icon Name="key" /></span>
        <div class="stack-sm">
            <h2 id="secret-title" class="card__title">@Title</h2>
            <p class="card__sub">Número @Channel.DisplayPhoneNumber</p>
        </div>
    </div>

    <Alert Kind="AlertKind.Warning" Title="Guárdalo ahora: no se vuelve a mostrar" data-testid="secret-warning">
        El secreto solo se muestra esta vez y Conversia únicamente guarda una huella de él. No recargues esta página: si lo pierdes, usa «Rotar secreto» para generar uno nuevo (el anterior dejaría de funcionar).
    </Alert>

    <dl class="secret__rows">
        <div class="secret__row">
            <dt>Ruta del webhook</dt>
            <dd>
                <code id="secret-path" class="secret__value" data-testid="secret-path">@Channel.WebhookPath</code>
                <button type="button" class="btn btn--secondary btn--sm copy-btn" data-copy-target="#secret-path" data-copy-done="Ruta copiada" aria-label="Copiar la ruta del webhook"><Icon Name="copy" Class="icon--sm" />Copiar</button>
            </dd>
        </div>
        <div class="secret__row">
            <dt>Secreto (cabecera <span class="mono">@WebhookRoutes.SecretHeader</span>)</dt>
            <dd>
                <code id="secret-value" class="secret__value" data-testid="secret-value">@Channel.WebhookSecret</code>
                <button type="button" class="btn btn--secondary btn--sm copy-btn" data-copy-target="#secret-value" data-copy-done="Secreto copiado" aria-label="Copiar el secreto del webhook"><Icon Name="copy" Class="icon--sm" />Copiar</button>
            </dd>
        </div>
    </dl>
    <p class="secret__status sr-only" role="status" aria-live="polite" data-copy-status></p>

    <p class="muted" data-testid="secret-howto">
        La dirección completa que debe llamar el proveedor es <span class="mono">&lt;dirección pública de la API&gt;@Channel.WebhookPath</span>. Esta pantalla no conoce esa dirección pública:
        para probar con el sandbox de 360dialog necesitas exponer la API con un túnel y registrar esa dirección y el secreto allí (consulta <span class="mono">docs/SIMULATOR.md</span>).
    </p>

    <div class="form-actions">
        <a class="btn btn--primary" href="/organizacion" data-testid="secret-dismiss"><Icon Name="check" />Ya lo guardé, cerrar</a>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public CreateChannelResponse Channel { get; set; } = default!;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;
}
