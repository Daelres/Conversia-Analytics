# Copy this file to `.env` (git-ignored) and replace the placeholders.
# docker compose reads `.env` automatically. Never commit the real file.
#
# Note: if a value contains `$`, write it as `$$`. Avoid `;`, `=` and `"` in
# POSTGRES_PASSWORD (it is embedded in an Npgsql connection string).

# Database, user and password of the PostgreSQL container (the API and the
# migrator receive the same values in their connection string). Replace the
# placeholder password with a strong one of your own.
POSTGRES_DB=conversia
POSTGRES_USER=conversia
POSTGRES_PASSWORD=change_me

# Secret used to sign the API's JWTs. MUST be at least 32 bytes (UTF-8);
# the API refuses to start otherwise. Generate one with:
#   openssl rand -base64 48
JWT_SIGNING_KEY=replace-with-a-random-secret-of-at-least-32-bytes

# Optional: shared secret between the Web and the API's error registry. With
# it the Web reports its own unexpected errors to POST /api/diagnostics/errors
# (header X-Error-Report-Key) and the user sees a code that support finds in
# the ErrorLogs table. MUST be at least 32 characters, otherwise the API and the
# Web refuse to start. Unset: the endpoint is off and the Web only logs its
# codes. Generate one with: openssl rand -base64 48   (docs/ERRORS.md)
# ERROR_REPORT_KEY=

# Optional: API key of the 360dialog WhatsApp number (configuration Dialog360:ApiKey).
# Nothing calls 360dialog yet; the webhook is authenticated by a per-channel secret
# (docs/WEBHOOKS.md). Never commit a real key.
# D360_API_KEY=

# Optional host ports (defaults shown).
# API_PORT=5030
# WEB_PORT=5112
# POSTGRES_PORT=5432

# Optional: password of the demo accounts, used ONLY with the demo overlay
#   docker compose -f docker-compose.yml -f docker-compose.demo.yml up --build
# (docs/DEMO.md). The API sets it on the seeded accounts and the Web shows it,
# so both services receive this one value. Defaults to Demo-Pass-2026!. It must
# be 12-128 characters with an uppercase letter, a lowercase letter and a
# digit, otherwise the API / Web refuse to start. The base docker-compose.yml
# ignores it. Write a `$` as `$$`.
# DEMO_PASSWORD=Demo-Pass-2026!
